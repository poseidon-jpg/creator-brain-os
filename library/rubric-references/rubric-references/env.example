# RUBRIC References settings.
# Copy this file to env.local, then edit env.local. Restart the bridge (node server.js) after any change.
# Every line is optional. Blank means "use the default". No quotes needed around values.

# Port the bridge listens on. Default 5298.
# If you change it, also change "bridge" in extension/config.js and the two host_permissions
# lines in extension/manifest.json, then reload the extension in chrome://extensions.
PORT=

# AI one-liner + tags. Optional. Blank = off: each save keeps the site's own description
# and gets no tags (you can still pick tags in the popup).
# Set it to a command that runs your agent once: it reads the prompt from standard input
# and prints the answer. Pick a small, cheap model (the job is one sentence) and no tools.
# If your agent is Claude Code, you can use:
#   AGENT_CMD=claude -p --model haiku --tools "" --no-session-persistence
# For any other agent, use its non-interactive (one-shot) mode that reads the prompt from
# standard input. Your agent can tell you the exact command.
AGENT_CMD=

# Seconds to wait for your agent before giving up and keeping the site's own description.
# Default 90.
AGENT_TIMEOUT_SECONDS=

# Optional shared secret. When set, every /api call must send it in an x-rubric-token header.
# Put the same value in extension/config.js (token: "..."). The wall page picks it up by itself.
RUBRIC_TOKEN=
