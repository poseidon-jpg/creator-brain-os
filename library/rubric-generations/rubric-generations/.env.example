# Rubric Generations - API Keys
# Copy this file to .env and fill in your keys.

# Google AI Studio - used by Nano Banana 2 (NB2) and Veo 3.1
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here

# Kie AI - used by Kling 3.0, Nano Banana Pro, and GPT Image 1.5
# Get yours at: https://kie.ai (sign up → API Keys)
KIE_API_KEY=your_kie_api_key_here

# WaveSpeed (optional) - alternative provider for some models
# Get yours at: https://wavespeed.ai
# WAVESPEED_API_KEY=your_wavespeed_key_here

# Server port (default: 5050)
# PORT=5050

# Generations folder (default: ./generations)
# GEN_DIR=./generations

# Optional shared secret for /api requests.
# If set, browser + agents must send header x-rubric-token with this value.
# RUBRIC_TOKEN=
