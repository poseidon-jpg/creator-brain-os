# RUBRIC Carousels settings. All optional. Copy this file to env.local and set the ones you want.
# Real environment variables win over env.local.

# The port the app runs on (a number after "node server.mjs" wins over this).
# CAROUSELS_PORT=50009

# The folder of carousels, relative to this folder or absolute.
# CAROUSELS_DIR=carousels

# Where the RUBRIC Agentic OS runs, for "Apply all comments". If nothing answers there, the button copies the comments instead.
# CAROUSELS_OS_ADDRESS=http://localhost:50000

# A shared secret every /api call must carry in the x-rubric-token header. The app's own pages send it for you.
# RUBRIC_TOKEN=
