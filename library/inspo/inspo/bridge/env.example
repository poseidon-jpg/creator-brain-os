# Inspo bridge settings. Copy this file to env.local and fill in only what you need.
# Every line is optional. Blank means "use the default". No keys or passwords are needed.

# Port the bridge listens on. If you change it, change BRIDGE at the top of extension/background.js too.
PORT=5299

# Where the inspo helper script lives. Relative paths start from this bridge folder.
# Default: ../skills/inspo/scripts/add-inspo.mjs (the layout inside the zip).
# After you copy the skill into your agent's skills folder, point this at that copy.
INSPO_HELPER=

# Where your inspos are saved. Use the same file everywhere (skill, bridge, console tab).
# Default: <your home folder>/inspos/inspos.json
INSPOS_FILE=

# The page the bridge shows at http://127.0.0.1:5299/
# Default: ../page/inspos.html
INSPO_PAGE=

# Full path to yt-dlp, only if it is not on your PATH.
YTDLP_PATH=

# Also keep a full-size copy of each thumbnail in this folder (handy as design references). Off when blank.
INSPO_THUMBS_DIR=
