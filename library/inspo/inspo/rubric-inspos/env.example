# RUBRIC Inspos settings. Copy this file to env.local and fill in only what you need.
# Every line is optional. No API keys are needed.

# Port for this tab's own server. Keep it equal to "port" in manifest.json.
PORT=5059

# Where your inspos are saved. Use the same file as the inspo skill and the bridge.
# Default: <your home folder>/inspos/inspos.json
INSPOS_FILE=

# Optional shared secret. When set, every /api request must send the header x-rubric-token.
# The page sends window.RUBRIC_TOKEN if you set it.
# RUBRIC_TOKEN=
