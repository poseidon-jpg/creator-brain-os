# RUBRIC Storyboards (beta) settings.
# Copy this file to env.local, then edit env.local. Restart the app (node server.mjs) after any change.
# Every line is optional. Blank means "use the default". No quotes needed around a whole value.

# Port the app listens on. Default 5303. The app opens at http://127.0.0.1:<PORT>/
PORT=

# Where your projects live. Default: the projects folder next to server.mjs.
PROJECTS_DIR=

# ---------------------------------------------------------------------------------------------
# YOUR AGENT (the wireframe and final-video steps)
# Boards, comments and shot times work without this. The two agent steps stay off until it is set.
#
# AGENT_CMD is the one command that runs your agent once, headless (no one at the keyboard).
# The app sends the prompt on standard input and runs the command in a fresh, empty folder.
#   - Wireframe step: your agent prints the storyboard as JSON. It needs no tools.
#   - Final step: your agent writes index.html into its folder. It must be allowed to create and
#     edit files there without asking you first, or it will stop and wait for an answer that never comes.
# Placeholders the app fills in (all optional):
#   {model}       the model you pick in the app, from WIREFRAME_MODELS / FINAL_MODELS below
#   {effort}      the effort you pick in the app: low, medium, high, xhigh or max
#   {step}        wireframe or final
#   {mcp_config}  path to an MCP config file with the image tool (only when IMAGE_TOOL is on)
# A placeholder that is empty for a run is left out, together with the flag right before it.
# Shape of a typical line (the flag names depend on your agent):
#   AGENT_CMD=your-agent --print --model {model} --effort {effort}
# Not sure what yours is? Ask your agent: "what command runs you once, non-interactively, reading
# the prompt from standard input, allowed to write files in the current folder without asking?"
# If your agent is Claude Code, use: AGENT_CMD=claude -p --model {model} --effort {effort} --permission-mode acceptEdits --permission-prompts none --allowedTools "Read,Glob,Grep,WebFetch,WebSearch,mcp__imagegen__generate_image" --output-format stream-json --verbose --no-session-persistence --strict-mcp-config --mcp-config {mcp_config} (and if Claude Code started this app for you, also AGENT_ENV_UNSET=CLAUDECODE,CLAUDE_CODE_*,CLAUDE_EFFORT,CLAUDE_PID,CLAUDE_AGENT_SDK*,AI_AGENT)
# Check it with:  node agent.mjs check   (prints the exact command for each step and runs nothing)
AGENT_CMD=

# Models to pick from in the app, used for {model}. Comma separated, "id" or "id=Label".
# Blank = your agent's own default model. Pick a fast model for wireframes and a strong one for finals.
#   WIREFRAME_MODELS=fast-model-id=Fast, other-model-id=Other
WIREFRAME_MODELS=
FINAL_MODELS=

# Stop a run that takes longer than this many minutes. Default 90.
AGENT_TIMEOUT_MINUTES=

# Environment variables to remove before your agent starts, comma separated. A name ending in *
# matches every variable starting with it. Use it when your agent refuses to start because it thinks
# it is running inside another session (this can happen when your agent started this app itself).
AGENT_ENV_UNSET=

# 1 = dry run: the Make and Revise buttons write the exact command and prompt to the project's logs
# folder and run nothing. Handy for checking your setup before you spend anything.
AGENT_DRY_RUN=

# ---------------------------------------------------------------------------------------------
# EXPORT MP4 (optional): needs Python 3.9+ with Playwright, and ffmpeg.
# The command that runs Python. Default: python on Windows, python3 elsewhere. "py -3" works too.
PYTHON=

# ---------------------------------------------------------------------------------------------
# AI IMAGES IN THE FINAL STEP (optional, off by default, costs money per image)
# Gives your agent a generate_image tool (GPT Image 2.5 on fal.ai) with a budget you pick per run.
# Needs all three: IMAGE_TOOL=on, your FAL_KEY (https://fal.ai/dashboard/keys), and {mcp_config}
# in AGENT_CMD so your agent loads the tool (for example: --mcp-config {mcp_config}).
IMAGE_TOOL=
FAL_KEY=

# ---------------------------------------------------------------------------------------------
# Optional shared secret. When set, every /api call must send it in an x-rubric-token header.
# The app's own page gets it automatically.
RUBRIC_TOKEN=
